# MongoDB Atlas (copy MONGODB_URI from atlas-credentials.env)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=qlub_one

API_URL=http://localhost:4000
MOCK_POS_URL=http://localhost:4100
ADMIN_PASSWORD=demo
SESSION_SECRET=change-me-to-a-long-random-string
PUBLIC_CUSTOMER_URL=http://localhost:3000   # used to build QR links
MOCK_POS_LATENCY_MS=300
MOCK_POS_FAILURE_RATE=0
ONBOARDING_BASELINE_MIN=30
# mock-pos -> api webhook (stretch). Leave empty to disable.
WEBHOOK_URL=http://localhost:4000/v1/webhooks/mock-pos
